# RAKIT — environment variables
# Copy this file to `.env` and adjust as needed:  cp .env.example .env

# Prisma connection string.
# Default setup uses a local SQLite file. IMPORTANT: Prisma resolves relative
# SQLite paths against the SCHEMA DIRECTORY (prisma/), so:
#   file:../db/custom.db  →  <project>/db/custom.db   (recommended default)
#   file:./db/custom.db   →  <project>/prisma/db/custom.db
# `bun run db:push` creates the file and applies the schema.
DATABASE_URL="file:../db/custom.db"
